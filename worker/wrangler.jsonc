{
  "name": "kindle-daybook",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.ttf"
      ],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "APP_NAME": "Daybook",
    "WEATHER_CITY": "İstanbul",
    "WEATHER_LAT": "41.0082",
    "WEATHER_LON": "28.9784",
    "APP_LANGUAGE": "tr"
  }
}
